        "messages": {
          "values": [
            {
              "content": "=You are a sales lead qualifier. Read the business research below and reply with ONE flat JSON object only. Start with { and end with }. No markdown, no code fences, no text outside the JSON. Every value must be a plain text string. No nested objects and no lists.\n\nUse exactly these keys:\n{\n  \"business_info\": \"2-3 sentences on what the business does and its industry\",\n  \"services_products\": \"main products or services, comma separated\",\n  \"location\": \"headquarters and main locations, or not found\",\n  \"growth\": \"sales or revenue, scale of operations, funding, launches, and whether they are hiring (with roles if known)\",\n  \"lead\": \"Hot or Warm or Cold\",\n  \"lead_reason\": \"one line explaining the score\"\n}\n\nScoring: Hot = established company with clear scale or growth signals and an active need. Warm = some fit but unclear need or size. Cold = very small, unclear, or little business information.\nUse only the research below. If something isn't mentioned, write \"not found\". Do not guess or invent numbers.\n\nBusiness research:\n{{ $json.result.business_info }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
